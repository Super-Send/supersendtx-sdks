{
  "name": "supersendtx/laravel",
  "description": "Laravel integration for the SuperSend TX transactional email API",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "email",
    "transactional",
    "supersend",
    "supersendtx"
  ],
  "authors": [
    {
      "name": "SuperSend TX"
    }
  ],
  "homepage": "https://ranla.ai",
  "support": {
    "docs": "https://docs.ranla.ai/frameworks/laravel",
    "issues": "https://github.com/Super-Send/supersendtx-sdks/issues",
    "source": "https://github.com/Super-Send/supersendtx-laravel"
  },
  "require": {
    "php": ">=8.1",
    "illuminate/mail": "^10.0|^11.0|^12.0",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "supersendtx/supersendtx": "^0.8.2",
    "supersendtx/symfony-mailer": "^0.8.2",
    "symfony/mailer": "^6.2|^7.0",
    "symfony/mime": "^6.2|^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "SuperSendTX\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SuperSendTX\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "SuperSendTX\\Laravel\\SuperSendTXServiceProvider"
      ],
      "aliases": {
        "SuperSendTX": "SuperSendTX\\Laravel\\Facades\\SuperSendTX"
      }
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
