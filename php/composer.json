{
  "name": "supersendtx/supersendtx",
  "description": "SuperSend TX transactional email API client for PHP",
  "version": "0.8.4",
  "type": "library",
  "license": "MIT",
  "keywords": ["email", "transactional", "supersend", "supersendtx"],
  "authors": [
    {
      "name": "SuperSend TX"
    }
  ],
  "homepage": "https://supersendtx.com",
  "support": {
    "docs": "https://docs.supersendtx.com/sdks/php",
    "issues": "https://github.com/Super-Send/supersendtx-sdks/issues",
    "source": "https://github.com/Super-Send/supersendtx-php"
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "SuperSendTX\\": "src/"
    },
    "classmap": [
      "src/Resources.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "SuperSendTX\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
