{
  "name": "ranla/ranla",
  "description": "Ranla email API client for PHP",
  "version": "0.8.5",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "email",
    "transactional",
    "ranla"
  ],
  "authors": [
    {
      "name": "Ranla"
    }
  ],
  "homepage": "https://ranla.ai",
  "support": {
    "docs": "https://docs.ranla.ai/sdks/php",
    "issues": "https://github.com/Super-Send/supersendtx-sdks/issues",
    "source": "https://github.com/Super-Send/supersendtx-sdks"
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "supersendtx/supersendtx": "^0.8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Ranla\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ranla\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
